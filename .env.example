# 复制为 .env 并填写真实值
# 上游（真正提供模型的服务）的 API 基址，注意不带末尾的 /chat/completions 或 /responses
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# 上游的 API Key
UPSTREAM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# 代理监听端口
PROXY_PORT=8123
# 把 Codex 发来的模型名改写成上游真实模型名（留空则原样透传）
UPSTREAM_MODEL=
# 上游对话协议：responses(默认，原生透传，保留自动工具调用) | chat(仅支持 chat/completions 的上游)
# 若上游原生支持 /v1/responses，务必用 responses：强转 chat 会导致模型不自动调用工具。
UPSTREAM_WIRE_API=responses
